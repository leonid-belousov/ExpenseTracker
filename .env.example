# Optional: `docker compose up --build` works without a .env file, using
# local-development defaults and an idle bot. To enable the bot, copy this file
# and fill in the values marked REQUIRED FOR THE BOT.
#   cp .env.example .env
# Never commit .env: it holds secrets.

# ---------------------------------------------------------------- database
POSTGRES_USER=expenses
# Empty means the local-development default "expenses-dev". Set your own for
# anything but local use, BEFORE the first start (it is stored when the data
# volume is initialised). URL-safe characters only (letters, digits, - _ .),
# because it is embedded in the connection URL.
POSTGRES_PASSWORD=
POSTGRES_DB=expenses

# ---------------------------------------------------------------- family
# REQUIRED FOR THE BOT (the default is two demo members).
# Comma-separated <telegram_user_id>:<display name>. These ids are
# the ONLY Telegram users the bot will serve, and the only members the
# dashboard can show or assign expenses to. Find your id with @userinfobot, or
# message the bot: it replies to strangers with their own id.
FAMILY_MEMBERS=111111111:Мама,222222222:Папа

# IANA time zone used for "today", "yesterday", weeks (Mon–Sun) and months.
APP_TIMEZONE=Europe/Moscow
# One ISO 4217 currency per deployment. Amounts have 2 decimal places.
CURRENCY=RUB

# ---------------------------------------------------------------- telegram
# REQUIRED FOR THE BOT. Create a bot with @BotFather. While empty, the bot
# container stays idle (healthy, no restarts) and the dashboard works as usual.
TELEGRAM_BOT_TOKEN=
# Reply language of the bot: ru or en.
BOT_LANGUAGE=ru

# ---------------------------------------------------------------- LLM
# REQUIRED FOR THE BOT. One of:
#   anthropic - Claude via the official Anthropic SDK (LLM_MODEL defaults to claude-opus-5-5)
#   openai    - any OpenAI-compatible Chat Completions API (OpenAI, OpenRouter,
#               vLLM, Ollama, ...); set LLM_BASE_URL and LLM_MODEL
#   mock      - rule-based model for LOCAL DEVELOPMENT ONLY (no key needed);
#               understands only simple phrasings, not for real use
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Optional override, e.g. https://openrouter.ai/api/v1 or http://host.docker.internal:11434/v1
LLM_BASE_URL=
# Anthropic only: workspace id (wrkspc_...) for API keys that are not scoped to
# a workspace (the API then answers "must include the anthropic-workspace-id
# header"). Find it in the Console under Settings -> Workspaces.
LLM_WORKSPACE_ID=
LLM_TIMEOUT=30s
# Maximum model calls (tool-use steps) per message, 2-20. A turn that needs
# more is rolled back and the user is told nothing was changed.
AGENT_MAX_STEPS=6

# ---------------------------------------------------------------- web/API
# Host ports; they are always bound to 127.0.0.1 (see README "Security").
WEB_PORT=8080
API_PORT=8081
# Origins allowed to call the API from a browser. Must match the dashboard
# URL(s), including WEB_PORT. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

LOG_LEVEL=info

# Go module proxy used when building the image. Override only if the default
# is unreachable from your network, e.g. https://goproxy.io,direct
GOPROXY=https://proxy.golang.org,direct
